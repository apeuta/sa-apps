# ============================================
# Environment Variables Template untuk SA Portal
# ============================================
# Copy file ini ke .env dan isi dengan nilai yang sesuai
# cp .env.example .env

# Database
POSTGRES_USER=sa_portal
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=sa_portal_db

# Backend
DATABASE_URL=postgresql+asyncpg://sa_portal:your-secure-password-here@db:5432/sa_portal_db
# JWT signing key — WAJIB di-set (tidak ada default). Pakai string acak min 32 char.
JWT_SECRET_KEY=your-random-secret-key-32-chars-minimum
# Environment runtime: development / staging / production.
# production memblok demo mode secara hard (app refuse-to-start jika DEMO_MODE=true).
ENVIRONMENT=development
# Registry image (default: docker.io; contoh lain: ghcr.io) dan owner/namespace-nya
# IMAGE_REGISTRY=docker.io
# IMAGE_OWNER=nikkisatmaka
# Tag image untuk compose.yaml (produksi), terpisah per komponen. Pin ke semver, hindari latest.
# BACKEND_IMAGE_TAG=latest
# FRONTEND_IMAGE_TAG=latest
# Demo mode (bypass OAuth). Default false; hanya aktif saat ENVIRONMENT bukan production.
DEMO_MODE=false
FRONTEND_URL=https://sa-portal.mov.co.id
# CORS allow-list origin dipisah koma. Untuk dev lokal gunakan http://localhost:3000.
# Jangan pakai "*" karena allow_credentials=True (kombinasi invalid/insecure).
CORS_ORIGINS=https://sa-portal.mov.co.id
GOOGLE_REDIRECT_URI=https://sa-portal.mov.co.id/api/v1/auth/callback
ALLOWED_DOMAINS=mov.co.id
# JSON email/wildcard -> role (Sales, SA, Lead_SA, Admin). Hanya berlaku saat
# user dibuat (login pertama); user yang sudah ada diubah lewat endpoint admin.
# WAJIB isi minimal satu Admin awal di produksi, kalau tidak semua user jadi SA.
ROLE_MAPPING='{"admin-awal@mov.co.id": "Admin"}'

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Guardrails LLM — batas & toggle lapisan keamanan pemanggilan LLM
LLM_MAX_INPUT_CHARS=20000          # batas karakter input teks (truncate, bukan reject)
LLM_MAX_DOCUMENT_BYTES=10485760    # 10 MB batas byte dokumen multimodal
GUARDRAIL_PII_DETECTION_ENABLED=true  # aktifkan deteksi PII (flag-and-log saja)

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Gmail (opsional) — untuk pengiriman email notifikasi via Gmail API.
# Kosongkan untuk melewati email (graceful fallback); in-app notification tetap jalan.
# GMAIL_CREDENTIALS: JSON service account key (satu baris). Butuh domain-wide
# delegation + GMAIL_SENDER bila mengirim atas nama user domain.
GMAIL_CREDENTIALS=
GMAIL_SENDER=

# Frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
BACKEND_URL=http://backend:8000
