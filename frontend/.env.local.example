# Environment Variables untuk Frontend Portal SA
# Salin file ini menjadi .env.local dan isi nilai yang sesuai

# URL API Backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google OAuth Client ID (untuk login button di frontend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# App URL (untuk PWA manifest dan redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000
