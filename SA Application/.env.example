# ============================================
# Portal SA MVP — Environment Variables
# ============================================
# Salin file ini menjadi .env dan isi nilai sesuai environment Anda.
# JANGAN commit file .env ke repository!
#
# Cara pakai:
#   cp .env.example .env
#   nano .env  # edit sesuai kebutuhan
#   docker compose up -d --build
# ============================================

# --- VM / Domain Configuration ---
# IP atau domain VM tempat deploy (digunakan untuk konfigurasi CORS dan redirect)
VM_HOST=your-vm-ip-or-domain
# Contoh: VM_HOST=192.168.1.100 atau VM_HOST=portal-sa.yourdomain.com

# --- Database (PostgreSQL) ---
POSTGRES_DB=sa_portal
POSTGRES_USER=sa_portal_user
POSTGRES_PASSWORD=ganti_dengan_password_kuat
DB_PORT=5432

# --- Backend (FastAPI) ---
SECRET_KEY=ganti_dengan_random_string_min_32_karakter
ENVIRONMENT=development
# Pilihan: development, staging, production
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# URL API yang bisa diakses dari browser client
NEXT_PUBLIC_API_URL=http://localhost:8000
# Nama aplikasi yang ditampilkan di UI
NEXT_PUBLIC_APP_NAME=Portal SA

# --- CORS ---
# URL frontend untuk whitelist CORS di backend
FRONTEND_URL=http://localhost:3000

# --- Demo Mode ---
# Bypass OAuth, login tanpa Google credentials (set false di production)
DEMO_MODE=true

# --- Google OAuth 2.0 ---
# Dapatkan dari Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Domain yang diizinkan login (pisahkan dengan koma, tanpa spasi atau bracket)
# Contoh: yourdomain.com atau yourdomain.com,partner.com
ALLOWED_DOMAINS=yourdomain.com
# Durasi session dalam jam
SESSION_TTL_HOURS=24

# --- Google Drive API ---
# Service account credentials (JSON string atau path ke file)
GOOGLE_DRIVE_CREDENTIALS=

# --- Google Calendar API ---
GOOGLE_CALENDAR_CREDENTIALS=
# Webhook endpoint untuk push notification (opsional, untuk production)
GCAL_WEBHOOK_ENDPOINT=

# --- Gmail API ---
GMAIL_CREDENTIALS=

# --- LLM Provider ---
# Provider yang aktif: gemini, openai, atau anthropic
LLM_PROVIDER=gemini
# API key untuk masing-masing provider (isi sesuai yang dipakai)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
